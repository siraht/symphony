#!/usr/bin/env bash
set -euo pipefail

invocation_cwd="$PWD"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

symphony_args=("$@")
workflow_path="$repo_root/WORKFLOW.md"
workflow_arg_index=-1

index=0
while [[ $index -lt ${#symphony_args[@]} ]]; do
  arg="${symphony_args[$index]}"

  case "$arg" in
    --port | --logs-root)
      index=$((index + 2))
      ;;

    --*)
      index=$((index + 1))
      ;;

    *)
      workflow_path="$arg"
      workflow_arg_index=$index
      index=$((index + 1))
      ;;
  esac
done

if [[ "$workflow_path" != /* ]]; then
  workflow_path="$invocation_cwd/$workflow_path"
fi

if [[ ! -f "$workflow_path" ]]; then
  echo "workflow file not found: $workflow_path" >&2
  exit 1
fi

cd "$repo_root"

if [[ $workflow_arg_index -ge 0 ]]; then
  symphony_args[$workflow_arg_index]="$workflow_path"
fi

if ! command -v mise >/dev/null 2>&1; then
  echo "missing mise; install mise or start Symphony from a shell where mise is on PATH" >&2
  exit 1
fi

workflow_uses_github_tracker() {
  grep -Eq '^[[:space:]]*kind:[[:space:]]*"?github"?[[:space:]]*$' "$workflow_path"
}

if { grep -q '\$GH_TOKEN' "$workflow_path" || workflow_uses_github_tracker; } &&
  [[ -z "${GH_TOKEN:-}" && -z "${GITHUB_TOKEN:-}" ]]; then
  if command -v gh >/dev/null 2>&1; then
    export GH_TOKEN="$(gh auth token 2>/dev/null || true)"
  fi
fi

if grep -q '\$GH_TOKEN' "$workflow_path" && [[ -z "${GH_TOKEN:-}" && -z "${GITHUB_TOKEN:-}" ]]; then
  echo "workflow requires GH_TOKEN but no token is available; run gh auth login or export GH_TOKEN" >&2
  exit 1
fi

if grep -q '\$WEBSITE_REPO_URL' "$workflow_path" && [[ -z "${WEBSITE_REPO_URL:-}" ]]; then
  workflow_dir="$(cd "$(dirname "$workflow_path")" && pwd)"
  if git -C "$workflow_dir" remote get-url origin >/dev/null 2>&1; then
    export WEBSITE_REPO_URL="$(git -C "$workflow_dir" remote get-url origin)"
  fi
fi

if grep -q '\$WEBSITE_REPO_URL' "$workflow_path" && [[ -z "${WEBSITE_REPO_URL:-}" ]]; then
  echo "workflow requires WEBSITE_REPO_URL but it could not be inferred; export WEBSITE_REPO_URL" >&2
  exit 1
fi

mise exec -- mix escript.build --force >/dev/null
exec mise exec -- ./bin/symphony "${symphony_args[@]}"
